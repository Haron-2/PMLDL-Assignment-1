.DS_Store

# --- Project data (regenerated / too large for Git) ---
# Raw and processed datasets stay local; .gitkeep keeps the folders in Git
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# --- Model artifacts ---
/models/*
!/models/.gitkeep

# --- Airflow ---
/services/airflow/logs/*
!/services/airflow/logs/.gitkeep
services/airflow/airflow.db
services/airflow/webserver_config.py

